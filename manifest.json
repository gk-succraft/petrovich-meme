{
  "manifest_version": 3,
  "name": "Petrovich Stickers",
  "version": "1.0",
  "description": "Custom stickers for Google Chat",
  "author": "Petrovich",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["clipboardWrite"],

  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://chat.google.com/*", "https://app.slack.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_title": "Petrovich Stickers",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
